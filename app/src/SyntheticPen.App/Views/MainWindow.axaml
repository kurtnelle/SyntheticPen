<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SyntheticPen.App.ViewModels"
        xmlns:i="https://github.com/projektanker/icons.avalonia"
        x:Class="SyntheticPen.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="SyntheticPen"
        Width="800" Height="640"
        MinWidth="500" MinHeight="240"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        WindowStartupLocation="Manual">
    <Grid RowDefinitions="*,8,48">
        <!-- Preview area: rounded panel; its inner Grid bounds = target region -->
        <Border Grid.Row="0"
                Background="#114DA3FF"
                BorderBrush="#4DA3FF"
                BorderThickness="1"
                CornerRadius="24"
                ClipToBounds="True">
            <Grid Name="PreviewArea">
                <Viewbox Stretch="Uniform" Margin="0">
                    <!-- Canvas sized to the SVG's source viewBox so the Viewbox
                         uniform-fits the entire viewBox (including padding around
                         the strokes), matching playback's FitToScreen behaviour. -->
                    <Canvas Width="{Binding PreviewSourceWidth}"
                            Height="{Binding PreviewSourceHeight}">
                        <Path Stroke="#6BE6FF" StrokeThickness="1.5"
                              Data="{Binding PreviewGeometry}"/>
                    </Canvas>
                </Viewbox>
                <!-- Visual corner markers + resize grips -->
                <Rectangle Name="GripNW" Width="12" Height="12" Fill="#4DA3FF"
                           HorizontalAlignment="Left"  VerticalAlignment="Top"
                           Cursor="TopLeftCorner"/>
                <Rectangle Name="GripNE" Width="12" Height="12" Fill="#4DA3FF"
                           HorizontalAlignment="Right" VerticalAlignment="Top"
                           Cursor="TopRightCorner"/>
                <Rectangle Name="GripSW" Width="12" Height="12" Fill="#4DA3FF"
                           HorizontalAlignment="Left"  VerticalAlignment="Bottom"
                           Cursor="BottomLeftCorner"/>
                <Rectangle Name="GripSE" Width="12" Height="12" Fill="#4DA3FF"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           Cursor="BottomRightCorner"/>
            </Grid>
        </Border>

        <!-- Controls bar: doubles as the drag handle -->
        <Border Name="DragBar"
                Grid.Row="2"
                Background="#1A1A1A"
                BorderBrush="#333333"
                BorderThickness="1"
                Cursor="SizeAll">
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="12,0">
                <StackPanel.Styles>
                    <Style Selector="Button.icon">
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="MinWidth" Value="32"/>
                        <Setter Property="FontSize" Value="14"/>
                    </Style>
                </StackPanel.Styles>
                <Border Width="8" Height="8" Background="#4DA3FF" CornerRadius="4" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StateText}"
                           FontFamily="Consolas" FontSize="12"
                           Foreground="#A6A6A6"
                           VerticalAlignment="Center"
                           Margin="4,0,4,0"
                           MinWidth="60"/>
                <Border Width="1" Height="20" Background="#1AFFFFFF" Margin="4,0"/>
                <Button Classes="icon" Command="{Binding OpenSvgCommand}" ToolTip.Tip="Open SVG">
                    <i:Icon Value="fa-folder-open"/>
                </Button>
                <ComboBox ItemsSource="{Binding InjectionModes}"
                          SelectedItem="{Binding SelectedInjectionMode}"
                          MinWidth="140"
                          ToolTip.Tip="Injection mode"/>
                <Button Classes="icon" Command="{Binding CalibrateCommand}" ToolTip.Tip="Calibrate target region">
                    <i:Icon Value="fa-crosshairs"/>
                </Button>
                <Button Classes="icon"
                        Command="{Binding StartCommand}"
                        Background="#4DA3FF" Foreground="#0A0A0A"
                        ToolTip.Tip="Start playback">
                    <i:Icon Value="fa-play"/>
                </Button>
                <Button Classes="icon" Command="{Binding AboutCommand}" ToolTip.Tip="About (Esc to stop playback)">
                    <i:Icon Value="fa-circle-info"/>
                </Button>
                <Border Width="1" Height="20" Background="#1AFFFFFF" Margin="4,0"/>
                <Button Name="CloseButton"
                        Classes="icon"
                        Background="Transparent"
                        Foreground="#A6A6A6"
                        ToolTip.Tip="Close SyntheticPen">
                    <i:Icon Value="fa-xmark"/>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
