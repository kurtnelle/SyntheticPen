<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SyntheticPen.App.ViewModels"
        x:Class="SyntheticPen.App.Views.RegionControls"
        x:DataType="vm:MainWindowViewModel"
        Title="SyntheticPen"
        SystemDecorations="None"
        WindowStartupLocation="Manual"
        Height="48"
        Topmost="True"
        ShowInTaskbar="True"
        CanResize="False"
        Background="#0A0A0A">
    <Border BorderBrush="#4DA3FF" BorderThickness="1,0,1,1">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="12,0">
            <Border Width="8" Height="8" Background="#4DA3FF" CornerRadius="4" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding StateText}"
                       FontFamily="Consolas" FontSize="12"
                       Foreground="#A6A6A6"
                       VerticalAlignment="Center"
                       MinWidth="100"/>
            <Border Width="1" Height="20" Background="#1AFFFFFF" Margin="6,0"/>
            <Button Content="Open SVG"      Command="{Binding OpenSvgCommand}"/>
            <ComboBox ItemsSource="{Binding InjectionModes}"
                      SelectedItem="{Binding SelectedInjectionMode}"
                      MinWidth="160"/>
            <Button Content="Calibrate"     Command="{Binding CalibrateCommand}"/>
            <Button Content="&#x25B6; Start" Command="{Binding StartCommand}" Background="#4DA3FF" Foreground="#0A0A0A"/>
            <Button Content="&#x25A0; Stop"  Command="{Binding StopCommand}"/>
            <Button Content="About"         Command="{Binding AboutCommand}"/>
            <Border Width="1" Height="20" Background="#1AFFFFFF" Margin="6,0"/>
            <Button Name="CloseButton"
                    Content="&#x2715;"
                    Background="Transparent"
                    Foreground="#A6A6A6"
                    FontSize="14"
                    Padding="10,6"
                    ToolTip.Tip="Close SyntheticPen"/>
        </StackPanel>
    </Border>
</Window>
