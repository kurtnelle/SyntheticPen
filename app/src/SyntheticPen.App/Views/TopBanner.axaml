<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SyntheticPen.App.ViewModels"
        x:Class="SyntheticPen.App.Views.TopBanner"
        x:DataType="vm:MainWindowViewModel"
        Title="SyntheticPen"
        SystemDecorations="None"
        WindowStartupLocation="Manual"
        Height="56"
        Topmost="True"
        ShowInTaskbar="True"
        CanResize="False"
        Background="#0A0A0A">
    <Border BorderBrush="#264DA3FF" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,0">
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <Border Width="10" Height="10" Background="#4DA3FF" CornerRadius="5"/>
                <TextBlock Text="SyntheticPen" FontSize="15" FontWeight="SemiBold" Foreground="#F5F5F5" VerticalAlignment="Center"/>
                <Border Width="1" Height="20" Background="#1AFFFFFF" Margin="6,0"/>
                <TextBlock Text="{Binding StateText}"
                           FontFamily="Consolas" FontSize="12"
                           Foreground="#A6A6A6"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Content="Open SVG"     Command="{Binding OpenSvgCommand}"/>
                <ComboBox ItemsSource="{Binding InjectionModes}"
                          SelectedItem="{Binding SelectedInjectionMode}"
                          MinWidth="160"/>
                <Button Content="Calibrate"    Command="{Binding CalibrateCommand}"/>
                <Button Content="&#x25B6; Start" Command="{Binding StartCommand}" Background="#4DA3FF" Foreground="#0A0A0A"/>
                <Button Content="&#x25A0; Stop"  Command="{Binding StopCommand}"/>
                <Button Content="About"        Command="{Binding AboutCommand}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
