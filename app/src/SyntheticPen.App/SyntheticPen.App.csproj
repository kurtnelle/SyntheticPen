<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Projektanker.Icons.Avalonia" />
    <PackageReference Include="Projektanker.Icons.Avalonia.FontAwesome" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="Avalonia.Diagnostics" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SyntheticPen.Core\SyntheticPen.Core.csproj" />
    <ProjectReference Include="..\SyntheticPen.Svg\SyntheticPen.Svg.csproj" />
    <ProjectReference Include="..\SyntheticPen.Motion\SyntheticPen.Motion.csproj" />
    <ProjectReference Include="..\SyntheticPen.Input\SyntheticPen.Input.csproj" />
    <ProjectReference Include="..\SyntheticPen.Rendering\SyntheticPen.Rendering.csproj" />
    <ProjectReference Include="..\SyntheticPen.Hotkeys\SyntheticPen.Hotkeys.csproj" />
    <ProjectReference Include="..\SyntheticPen.Vectorize\SyntheticPen.Vectorize.csproj" />
  </ItemGroup>
</Project>
