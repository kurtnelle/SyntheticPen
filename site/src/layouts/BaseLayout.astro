---
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const {
  title = 'SyntheticPen',
  description = 'Replay SVG paths, signatures, and text as real Windows pen input. Free on the Microsoft Store.',
  image = '/og.png',
} = Astro.props;

const site = Astro.site ?? new URL('https://syntheticpen.com');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(image, site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0A0A0A" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SyntheticPen" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <div class="bg-grid" aria-hidden="true"></div>
    <slot />
    <!-- Cloudflare Web Analytics (cookieless, no personal data) -->
    <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "ef69fd4d7f5a4df2bb0106e7ff6a351d"}'></script>
    <!-- End Cloudflare Web Analytics -->
  </body>
</html>
